# --- Telegram ---
TELEGRAM_BOT_TOKEN=            # from @BotFather
ALLOWED_USER_IDS=              # comma-separated numeric Telegram user IDs, empty = open to all (not recommended)
ALLOWED_CHAT_IDS=              # optional, same idea for group chats

# --- Local Bot API server (for files >50MB) ---
USE_LOCAL_BOT_API=true
TELEGRAM_API_ID=               # from https://my.telegram.org
TELEGRAM_API_HASH=

# --- Downloading ---
MAX_CONCURRENT_DOWNLOADS=2
MAX_RETRIES=2
COOKIES_FILE_PATH=/data/cookies.txt   # optional, see README for how to export
INCLUDE_CAPTION=true
KEEP_FILES_AFTER_SEND=false

# --- Rate limiting ---
MAX_JOBS_PER_USER_PER_MINUTE=5

# --- Logging ---
LOG_LEVEL=INFO
